# Public site URL (used for canonical/OG links — defaults to https://kofiyesu.com)
SITE_URL=https://kofiyesu.com

# Sentry — optional client error monitoring. Leave blank to disable.
VITE_SENTRY_DSN=
# Optional release tag (e.g. git SHA in CI)
# VITE_APP_VERSION=1.0.0
# Source map upload (build only — never commit the token)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
