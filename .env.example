# Neon Postgres (Prisma) — pooled URL for the app (Neon "Pooled connection")
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct URL for prisma migrate on CI (Neon "Direct connection") — set in Vercel for builds
# DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Paystack (GHS — card & Mobile Money)
# PAYSTACK_SECRET_KEY=
# VITE_PAYSTACK_PUBLIC_KEY=
# Public site URL for payment callbacks (defaults to https://kofiyesu.com)
SITE_URL=https://kofiyesu.com

# WhatsApp (country code, no + — e.g. 233XXXXXXXXX)
VITE_WHATSAPP_NUMBER=

# Sentry (client error monitoring, tracing, session replay)
VITE_SENTRY_DSN=
# Optional release tag (e.g. git SHA in CI)
# VITE_APP_VERSION=1.0.0
# Source map upload (build only — never commit token)
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=
# SENTRY_PROJECT=
